# Kopieer naar .env en vul alleen lokaal de waarden in. Dit bestand bevat geen secrets.
NODE_ENV=production
PUBLIC_BASE_URL=https://studio.example.com
CADDY_SITE_ADDRESS=studio.example.com

# Alleen Caddy publiceert 80 en 443. Kies vrije hostpoorten wanneer nodig.
HTTP_PORT=80
HTTPS_PORT=443

# Persistente hostopslag. Gebruik een lokale SSD, geen SMB-share voor PostgreSQL.
STUDIO_DATA_DIR=/srv/interieurstudio
POSTGRES_DB=interieurstudio

# Maak elk geheim minstens 32 willekeurige tekens lang. Laat ze bij een herstart ongewijzigd.
POSTGRES_PASSWORD=VERVANG_DOOR_EEN_UNIEK_GEHEIM
MIGRATION_DATABASE_PASSWORD=VERVANG_DOOR_EEN_UNIEK_GEHEIM
RUNTIME_DATABASE_PASSWORD=VERVANG_DOOR_EEN_UNIEK_GEHEIM
AUTH_DATABASE_PASSWORD=VERVANG_DOOR_EEN_UNIEK_GEHEIM
AUTH_SECRET=VERVANG_DOOR_EEN_UNIEK_GEHEIM_VAN_MINIMAAL_32_TEKENS

# Alleen intern Docker-verkeer bereikt de API; 0.0.0.0 is nodig voor Caddy in hetzelfde netwerk.
API_HOST=0.0.0.0
API_PORT=4311
QUOTE_CHROMIUM_PATH=/usr/bin/chromium

# Back-up: twee versleutelde restic-bestemmingen zijn verplicht. Bewaar het
# restic-wachtwoord en de originele .env afzonderlijk van deze host.
BACKUP_RESTIC_PASSWORD_FILE=/etc/interieurstudio/restic-password
BACKUP_SYNOLOGY_REPOSITORY=VERVANG_DOOR_EEN_RESTIC_REPOSITORY_OP_SYNOLOGY
BACKUP_EXTERNAL_REPOSITORY=VERVANG_DOOR_EEN_APARTE_EXTERN_BEHEERDE_REPOSITORY
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
