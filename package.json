{
  "name": "interieurstudio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.22.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:api": "tsx apps/api/src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/geometry.test.ts tests/storage.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup": "tsx scripts/setup.ts",
    "check": "pnpm build && pnpm test",
    "probe:pdf": "tsx scripts/pdf-probe.ts",
    "probe:quote": "tsx scripts/quote-pdf-probe.ts",
    "probe:presentation": "tsx scripts/presentation-probe.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@react-three/fiber": "9.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@vitejs/plugin-react": "5.2.0",
    "better-auth": "1.7.2",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "konva": "10.3.3",
    "lucide-react": "1.41.0",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "pptxgenjs": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "19.2.6",
    "tailwindcss": "4.3.3",
    "three": "0.185.1",
    "vite": "7.3.6",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "embedded-postgres": "18.4.0-beta.17",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
